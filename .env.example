# Copy to .env.local for development. Never commit .env.local.
DATABASE_URL=postgres://plumbline_app:dev@localhost:5432/plumbline?sslmode=disable
DATABASE_URL_OWNER=postgres://postgres:postgres@localhost:5432/plumbline?sslmode=disable
# DATABASE_ROLE=plumbline_app            # local only: connect with the owner URL and assume the app role
LISTEN=:8080
KMS_KEY_ID=local                      # "local" signs with LOCAL_SIGNING_KEY; staging/prod use a KMS key ARN (ECC_NIST_P256)
LOCAL_SIGNING_KEY=.dev/local-signing.pem
AWS_REGION=ap-southeast-2
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
PUBLIC_BASE_URL=http://localhost:8080
VERIFY_BASE_URL=http://localhost:8081
CHECKPOINT_REPO=lumetrix/plumbline-checkpoints
GITHUB_TOKEN=
RESEND_API_KEY=
